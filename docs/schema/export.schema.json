{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExportManifest",
  "description": "`export --json`.",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExportedFile"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "source": {
      "$ref": "#/$defs/SourceInfo"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "source",
    "files",
    "warnings"
  ],
  "$defs": {
    "ExportedFile": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "crop": {
          "description": "Exported region as [x, y, width, height] fractions of the page or frame.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "error": {
          "description": "Why the item could not be decoded; no file is written for it.",
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "frame": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "index": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "path": {
          "description": "The written file; with --dry-run the file that would be written. Absent when the item\ncould not be decoded.",
          "type": [
            "string",
            "null"
          ]
        },
        "scale": {
          "description": "Pixels per PDF point, or written / native pixels for raster sources.",
          "type": "number",
          "format": "double"
        },
        "time": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "index",
        "width",
        "height",
        "scale"
      ]
    },
    "FileInfo": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "width",
        "height"
      ]
    },
    "PageSizeGroup": {
      "description": "Consecutive or scattered pages sharing one size, e.g. 595x842 pt on pages \"1-12\".",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "height_pt": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "orientation": {
          "type": "string"
        },
        "pages": {
          "type": "string"
        },
        "width_pt": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "width_pt",
        "height_pt",
        "orientation",
        "count",
        "pages"
      ]
    },
    "SourceInfo": {
      "description": "The input, by kind. `page_sizes` and `files` are only reported by `probe`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pdf"
            },
            "page_sizes": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/PageSizeGroup"
              }
            },
            "pages": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "path": {
              "type": "string"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "path",
            "pages"
          ]
        },
        {
          "type": "object",
          "properties": {
            "codec": {
              "type": [
                "string",
                "null"
              ]
            },
            "coded_height": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "coded_width": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "duration": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "fps": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "height": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "video"
            },
            "path": {
              "type": "string"
            },
            "rotation": {
              "type": "integer",
              "format": "int32"
            },
            "width": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "path",
            "width",
            "height",
            "coded_width",
            "coded_height",
            "rotation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "duration": {
              "type": "number",
              "format": "double"
            },
            "frames": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "height": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "anim"
            },
            "path": {
              "type": "string"
            },
            "width": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "path",
            "frames",
            "duration",
            "width",
            "height"
          ]
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "files": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/FileInfo"
              }
            },
            "kind": {
              "type": "string",
              "const": "images"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name",
            "count"
          ]
        }
      ]
    }
  }
}
