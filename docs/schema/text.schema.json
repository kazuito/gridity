{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TextReport",
  "description": "`text --json`.",
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PageText"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "source": {
      "$ref": "#/$defs/SourceInfo"
    }
  },
  "required": [
    "schema_version",
    "source",
    "pages"
  ],
  "$defs": {
    "Content": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "empty"
          ]
        },
        {
          "description": "Readable as extracted text.",
          "type": "string",
          "const": "text"
        },
        {
          "description": "Text plus figures, tables or diagrams worth looking at.",
          "type": "string",
          "const": "mixed"
        },
        {
          "description": "Little or unextractable text: look at the image.",
          "type": "string",
          "const": "graphics"
        }
      ]
    },
    "FileInfo": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "width",
        "height"
      ]
    },
    "PageSizeGroup": {
      "description": "Consecutive or scattered pages sharing one size, e.g. 595x842 pt on pages \"1-12\".",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "height_pt": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "orientation": {
          "type": "string"
        },
        "pages": {
          "type": "string"
        },
        "width_pt": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "width_pt",
        "height_pt",
        "orientation",
        "count",
        "pages"
      ]
    },
    "PageText": {
      "type": "object",
      "properties": {
        "body_pt": {
          "description": "Median text size in points, weighted by characters.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "chars": {
          "description": "Visible characters, whitespace excluded.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "content": {
          "$ref": "#/$defs/Content"
        },
        "image_cover": {
          "description": "Share of the page covered by images / by drawings.",
          "type": "number",
          "format": "double"
        },
        "images": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "scripts": {
          "description": "Sub- and superscript glyphs, a sign of formulas.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "short_lines": {
          "description": "Share of text lines with at most two characters: scattered formula parts or labels.",
          "type": "number",
          "format": "double"
        },
        "small_pt": {
          "description": "Size that 90% of the text is at least as large as.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "text": {
          "type": "string"
        },
        "unmapped": {
          "description": "Share of visible glyphs without a Unicode mapping.",
          "type": "number",
          "format": "double"
        },
        "vector_cover": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "page",
        "content",
        "chars",
        "unmapped",
        "scripts",
        "short_lines",
        "images",
        "image_cover",
        "vector_cover",
        "text"
      ]
    },
    "SourceInfo": {
      "description": "The input, by kind. `page_sizes` and `files` are only reported by `probe`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pdf"
            },
            "page_sizes": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/PageSizeGroup"
              }
            },
            "pages": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "path": {
              "type": "string"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "path",
            "pages"
          ]
        },
        {
          "type": "object",
          "properties": {
            "codec": {
              "type": [
                "string",
                "null"
              ]
            },
            "coded_height": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "coded_width": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "duration": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "fps": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "height": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "video"
            },
            "path": {
              "type": "string"
            },
            "rotation": {
              "type": "integer",
              "format": "int32"
            },
            "width": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "path",
            "width",
            "height",
            "coded_width",
            "coded_height",
            "rotation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "duration": {
              "type": "number",
              "format": "double"
            },
            "frames": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "height": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "anim"
            },
            "path": {
              "type": "string"
            },
            "width": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "path",
            "frames",
            "duration",
            "width",
            "height"
          ]
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "files": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/FileInfo"
              }
            },
            "kind": {
              "type": "string",
              "const": "images"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name",
            "count"
          ]
        }
      ]
    }
  }
}
